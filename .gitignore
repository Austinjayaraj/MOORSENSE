# ==============================================================================
# Ocean Sentry - Comprehensive .gitignore
# Frontend (React + Vite + TypeScript) & Backend (FastAPI + PyTorch + DirectML)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.local
!*.example

# Certificates and keys
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 2. Dependencies & Package Managers
# ------------------------------------------------------------------------------
# Node.js
node_modules/
.pnp/
.pnp.js

# Node Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Frontend Build Outputs & Caches
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
.vite/
**/.vite/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 4. Python Virtual Environments
# ------------------------------------------------------------------------------
venv/
venv_gpu/
.venv/
env/
ENV/
env.bak/
venv.bak/
*/venv/
*/venv_gpu/
*/.venv/

# ------------------------------------------------------------------------------
# 5. Python Bytecode & Runtime Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ------------------------------------------------------------------------------
# 6. Python Distribution & Packaging
# ------------------------------------------------------------------------------
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 7. Testing, Code Coverage & Linting Caches
# ------------------------------------------------------------------------------
# Python testing & coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.tox/
.nox/

# Playwright & MCP test artifacts
.playwright-mcp/
test-results/
playwright-report/
blob-report/

# ------------------------------------------------------------------------------
# 8. Oceanographic Datasets & Data Pipelines (CMEMS, Argo, Ingestion)
# ------------------------------------------------------------------------------
# Ingestion, processed, and training data directories
backend/data/raw/*
!backend/data/raw/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep
backend/data/training/*
!backend/data/training/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/training/*
!data/training/.gitkeep

# Large binary / oceanographic data formats
*.nc
*.nc4
*.grib
*.grb
*.grb2
*.parquet
*.h5
*.hdf5

# Root training dataset
gesture_dataset.csv

# ------------------------------------------------------------------------------
# 9. Trained Machine Learning Models, Weights & Checkpoints
# ------------------------------------------------------------------------------
# Backend ML model outputs (PyTorch, ONNX, Scikit-learn, Joblib)
backend/ml/models/*
!backend/ml/models/.gitkeep
backend/test.joblib

# Generic model weight formats
*.joblib
*.pt
*.pth
*.onnx
*.pkl
*.pickle
*.ckpt
*.safetensors

# Preserve static web models used directly by the frontend
!public/model/**

# ------------------------------------------------------------------------------
# 10. IDEs & Editors
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ------------------------------------------------------------------------------
# 11. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory

# Local buoy telemetry journal
backend/data/*.sqlite3*
