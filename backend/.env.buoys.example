BUOY_POLL_INTERVAL_SECONDS=60
BUOY_LIVE_THRESHOLD_SECONDS=3600
BUOY_STALE_THRESHOLD_SECONDS=10800
BUOY_OFFLINE_THRESHOLD_SECONDS=86400
# Debug diagnostics are disabled in production; both settings are required.
ENVIRONMENT=production
BUOY_DEBUG_SOURCE_ENABLED=false
BUOY_INGESTION_ENABLED=true
BUOY_OUTBOX_PATH=data/buoy_outbox.sqlite3
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
BUOY_DATABASE_URL=postgresql://moorsense:moorsense@localhost:15432/moorsense
BUOY_WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
